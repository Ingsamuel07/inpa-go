// ==============================================================================
// INPAHU-GO: Prisma Schema para Neon PostgreSQL Serverless
// Arquitectura multi-esquema con aislamiento por dominio funcional
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "directory", "academic", "attendance", "location", "imports"]
}

// ------------------------------------------------------------------------------
// DOMINIO AUTH: Credenciales, Roles y Sesiones Criptográficas
// ------------------------------------------------------------------------------

enum Role {
  admin
  teacher
  student

  @@schema("auth")
}

model User {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionalEmail String           @unique(map: "users_email_unique") @map("institutional_email") @db.VarChar(254)
  passwordHash       String           @map("password_hash") @db.Text
  role               Role
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshSessions    RefreshSession[]

  @@index([role, active], map: "users_role_active_idx")
  @@map("users")
  @@schema("auth")
}

model RefreshSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "refresh_sessions_user_active_idx")
  @@map("refresh_sessions")
  @@schema("auth")
}

// ------------------------------------------------------------------------------
// DOMINIO DIRECTORY: Perfiles Institucionales de Usuarios
// ------------------------------------------------------------------------------

model Profile {
  userId            String   @id @map("user_id") @db.Uuid
  fullName          String   @map("full_name") @db.VarChar(180)
  institutionalCode String   @unique @map("institutional_code") @db.VarChar(50)
  profileType       String   @map("profile_type")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([profileType, active], map: "profiles_type_active_idx")
  @@map("profiles")
  @@schema("directory")
}

// ------------------------------------------------------------------------------
// DOMINIO ACADEMIC: Asignaturas, Grupos, Asignación Docente y Matrículas
// ------------------------------------------------------------------------------

enum EnrollmentStatus {
  active
  withdrawn
  completed

  @@schema("academic")
}

model Course {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(180)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  groups    Group[]

  @@map("courses")
  @@schema("academic")
}

model Group {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId           String              @map("course_id") @db.Uuid
  code               String              @db.VarChar(40)
  term               String              @db.VarChar(40)
  active             Boolean             @default(true)
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  enrollments        Enrollment[]

  @@unique([courseId, code, term])
  @@map("groups")
  @@schema("academic")
}

model TeacherAssignment {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherUserId String @map("teacher_user_id") @db.Uuid
  groupId       String @map("group_id") @db.Uuid
  group         Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([teacherUserId, groupId])
  @@index([teacherUserId, groupId], map: "teacher_assignments_teacher_idx")
  @@map("teacher_assignments")
  @@schema("academic")
}

model Enrollment {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentUserId String           @map("student_user_id") @db.Uuid
  groupId       String           @map("group_id") @db.Uuid
  status        EnrollmentStatus @default(active)
  group         Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, groupId])
  @@index([studentUserId, status], map: "enrollments_student_idx")
  @@index([groupId, status], map: "enrollments_group_idx")
  @@map("enrollments")
  @@schema("academic")
}

// ------------------------------------------------------------------------------
// DOMINIO ATTENDANCE: Sesiones Académicas y Registros de Asistencia
// ------------------------------------------------------------------------------

enum SessionStatus {
  open
  paused
  closed

  @@schema("attendance")
}

enum AttendanceStatus {
  present
  absent
  late
  excused

  @@schema("attendance")
}

model Session {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId       String             @map("group_id") @db.Uuid
  teacherUserId String             @map("teacher_user_id") @db.Uuid
  startsAt      DateTime           @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime?          @map("ends_at") @db.Timestamptz(6)
  status        SessionStatus      @default(open)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  records       AttendanceRecord[]

  @@index([groupId, startsAt(sort: Desc)], map: "attendance_sessions_group_date_idx")
  @@map("sessions")
  @@schema("attendance")
}

model AttendanceRecord {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String           @map("session_id") @db.Uuid
  studentUserId String           @map("student_user_id") @db.Uuid
  status        AttendanceStatus
  confirmedBy   String           @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime         @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  evidence      Json             @default("{}")
  session       Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentUserId])
  @@index([studentUserId, confirmedAt(sort: Desc)], map: "attendance_records_student_idx")
  @@map("records")
  @@schema("attendance")
}

// ------------------------------------------------------------------------------
// DOMINIO LOCATION: Geocercas Institucionales y Validaciones GPS
// ------------------------------------------------------------------------------

model Geofence {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String               @db.VarChar(120)
  latitude     Float
  longitude    Float
  radiusMeters Int                  @map("radius_meters")
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  validations  LocationValidation[]

  @@map("geofences")
  @@schema("location")
}

model LocationValidation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentUserId  String    @map("student_user_id") @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  geofenceId     String?   @map("geofence_id") @db.Uuid
  distanceMeters Int       @map("distance_meters")
  withinRadius   Boolean   @map("within_radius")
  accuracyMeters Int?      @map("accuracy_meters")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  geofence       Geofence? @relation(fields: [geofenceId], references: [id], onDelete: SetNull)

  @@index([studentUserId, createdAt(sort: Desc)], map: "location_validations_student_date_idx")
  @@map("validations")
  @@schema("location")
}

// ------------------------------------------------------------------------------
// DOMINIO IMPORTS: Auditoría de Cargas Masivas Excel y Registro de Errores
// ------------------------------------------------------------------------------

enum BatchStatus {
  processing
  completed
  completed_with_errors
  failed

  @@schema("imports")
}

model ImportBatch {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdBy    String        @map("created_by") @db.Uuid
  fileName     String        @map("file_name") @db.VarChar(255)
  status       BatchStatus
  totalRows    Int           @default(0) @map("total_rows")
  acceptedRows Int           @default(0) @map("accepted_rows")
  rejectedRows Int           @default(0) @map("rejected_rows")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  errors       ImportError[]

  @@map("batches")
  @@schema("imports")
}

model ImportError {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId   String      @map("batch_id") @db.Uuid
  rowNumber Int         @map("row_number")
  fieldName String?     @map("field_name") @db.VarChar(100)
  errorCode String      @map("error_code") @db.VarChar(80)
  message   String      @db.Text
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, rowNumber], map: "import_errors_batch_row_idx")
  @@map("errors")
  @@schema("imports")
}
